# Runtime mode and trusted frontend origin. APP_ENV (or ENVIRONMENT) = production
# makes startup fail closed on missing secrets and enables CSRF + write-rate
# limiting.
APP_ENV=development
FRONTEND_BASE_URL=http://localhost:3010
CORS_ALLOWED_ORIGINS=http://localhost:3010

# Database. Local development uses the discrete PG_LOCAL_* parts below; a
# deployed environment sets a complete DATABASE_URL instead (and it is
# required in production). Pool sizing is per process — tune against the
# database tier.
# DATABASE_URL=postgresql://user:pass@host:5432/agenda_db
# DB_POOL_SIZE=5                 # production: 2
# DB_MAX_OVERFLOW=10             # production: 1
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
PG_LOCAL_HOST=localhost
PG_LOCAL_PORT=55432
PG_LOCAL_USER=agenda
PG_LOCAL_PASSWORD=agenda_local_dev
AGENDA_LOCAL_DATABASE=agenda_db

# Azure PostgreSQL connection used only by scripts/local_to_azure.py and
# scripts/azure_to_local.py. Keep these values out of source control.
AZURE_PG_HOST=your-server.postgres.database.azure.com
AZURE_PG_PORT=5432
AZURE_PG_USER=your-user
AZURE_PG_PASSWORD=replace-with-azure-postgres-password
AZURE_PG_DATABASE=agenda_db
AZURE_PG_SSLMODE=require

# Next.js server-only proxy target for /api/* (never exposed to the browser).
# INTERNAL_API_URL=http://127.0.0.1:8005

# WhatsApp webhook durable handoff.
YCLOUD_WEBHOOK_SIGNING_SECRET=replace-with-provider-signing-secret
# YCLOUD_WEBHOOK_TOLERANCE_SECONDS=300
# WEBHOOK_TASK_QUEUE=local            # local (durable webhook_receipts ledger)
# WEBHOOK_INLINE_PROCESSING=true      # default: true unless production
# WEBHOOK_PROCESSOR_POLL_SECONDS=2
# WEBHOOK_PROCESSOR_MAX_ATTEMPTS=8

# Candidate worker claim lease.
# CANDIDATE_CLAIM_LEASE_SECONDS=300
# CANDIDATE_MAX_ATTEMPTS=5

# Per-instance write burst guard (production only).
# WRITE_RATE_LIMIT_MAX=120
# WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# LLM provider (required in production).
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_MODEL=gpt-4o

# Keep this secret unique and out of source control in every deployed environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=tennis-os
JWT_AUDIENCE=tennis-os-web
AUTH_SESSION_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=agenda_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Authentication email delivery. Leave disabled for local development unless
# testing with a dedicated mailbox.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtpout.secureserver.net
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURITY=ssl
EMAIL_SMTP_USERNAME=notifications@example.com
EMAIL_SMTP_PASSWORD=replace-with-mailbox-or-app-password
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Tennis OS
EMAIL_REPLY_TO=support@example.com
EMAIL_SMTP_TIMEOUT_SECONDS=20
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_PROCESSING_TIMEOUT_SECONDS=120

# Authentication policy and delivery limits.
AUTH_ACTIVATION_TOKEN_TTL_MINUTES=60
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_EMAIL_MAX_SENDS_PER_HOUR=5
# Per-platform-admin tenant provisioning limit. Successful creates are counted
# by administrator identity and source IP in a rolling hour.
ADMIN_TENANT_CREATE_MAX_PER_HOUR=10
ACCOUNT_REQUEST_MAX_PER_EMAIL_PER_DAY=3
ACCOUNT_REQUEST_MAX_PER_IP_PER_HOUR=20
ACCOUNT_REQUEST_APPROVAL_MAX_PER_ADMIN_PER_HOUR=20
ACCOUNT_ACTIVATION_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_REQUEST_REJECTED_RETENTION_DAYS=180
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=15
